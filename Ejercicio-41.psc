Algoritmo TablasMultiplicar
	Definir tabla, i, resultado Como Entero
	
	Para tabla <- 1 Hasta 10 Hacer
		Escribir "Tabla del ", tabla
		
		Para i <- 1 Hasta 10 Hacer
			resultado <- tabla * i
			Escribir tabla, " x ", i, " = ", resultado
		FinPara
		
		Escribir "--------------------"
	FinPara
FinAlgoritmo

